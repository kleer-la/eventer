<h1><%= t('handoff.consent.title', client: @pre_auth.client.name) %></h1>

<p><%= t('handoff.consent.authorizing_as_html', email: current_handoff_user.email) %>
  <span class="muted"><%= t('handoff.consent.not_you') %></span>
  <%= button_to t('handoff.consent.change_account'), handoff_sign_out_path(return_to: request.fullpath), method: :delete, class: 'secondary' %>
</p>

<p><%= t('handoff.consent.will_be_able', client: @pre_auth.client.name) %></p>
<ul>
  <li><%= t('handoff.consent.permission') %></li>
</ul>
<p class="muted"><%= t('handoff.consent.nothing_else') %></p>

<div class="actions">
  <%= form_tag oauth_authorization_path, method: :post do %>
    <%= render 'doorkeeper/authorizations/pre_auth_fields' %>
    <%= submit_tag t('handoff.consent.authorize') %>
  <% end %>
  <%= form_tag oauth_authorization_path, method: :delete do %>
    <%= render 'doorkeeper/authorizations/pre_auth_fields' %>
    <%= submit_tag t('handoff.consent.deny'), class: 'danger' %>
  <% end %>
</div>
