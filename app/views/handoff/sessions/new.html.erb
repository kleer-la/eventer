<h1><%= t('handoff.sign_in.title') %></h1>
<% if flash[:not_requested] %>
  <div class="flash alert"><%= t('handoff.sign_in.not_requested_html', email: flash[:not_requested], url: HandoffUser.resource_url(handoff_locale)) %></div>
<% end %>
<p><%= t('handoff.sign_in.intro') %></p>

<%= button_to t('handoff.sign_in.google_button'), handoff_user_google_oauth2_omniauth_authorize_path, method: :post %>

<p class="muted"><%= t('handoff.sign_in.privacy') %></p>
