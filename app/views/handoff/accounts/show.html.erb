<header>
  <h1><%= t('handoff.account.title') %></h1>
  <span class="muted"><%= @user.email %> · <%= button_to t('handoff.account.sign_out'), handoff_sign_out_path, method: :delete, class: 'secondary' %></span>
</header>

<h2><%= t('handoff.account.token_title') %></h2>
<% if @issued %>
  <p><%= t('handoff.account.copy_now_html') %></p>
  <pre><code id="handoff-token"><%= @issued %></code></pre>
  <p><%= t('handoff.account.in_claude_code') %></p>
  <pre>SESSION_HANDOFF_TTS_TOKEN=<%= @issued %></pre>
  <%= button_to t('handoff.account.regenerate'), handoff_token_path, method: :post, class: 'secondary' %>
  <%= button_to t('handoff.account.revoke'), handoff_token_path, method: :delete, class: 'danger' %>
<% elsif @token %>
  <p><%= t('handoff.account.generated_on', date: @token.created_at.strftime('%d/%m/%Y')) %>
    <% if @token.last_used_at %><%= t('handoff.account.last_used', time: @token.last_used_at.strftime('%d/%m/%Y %H:%M')) %><% else %><%= t('handoff.account.never_used') %><% end %></p>
  <p class="muted"><%= t('handoff.account.lost_hint') %></p>
  <%= button_to t('handoff.account.regenerate'), handoff_token_path, method: :post, class: 'secondary' %>
  <%= button_to t('handoff.account.revoke'), handoff_token_path, method: :delete, class: 'danger' %>
<% else %>
  <p><%= t('handoff.account.no_token') %></p>
  <%= button_to t('handoff.account.generate'), handoff_token_path, method: :post %>
<% end %>

<h2><%= t('handoff.account.connector_title') %></h2>
<p><%= t('handoff.account.connector_intro_html') %></p>
<pre><%= request.base_url %>/handoff/mcp</pre>
<p class="muted"><%= t('handoff.account.connector_note_html') %></p>

<h2><%= t('handoff.account.usage_title') %></h2>
<p><%= t('handoff.account.usage', count: @user.briefings_this_month, max: TtsUsage.limits.find { |l| l[:key] == 'TTS_MAX_BRIEFINGS_PER_MONTH_PER_USER' }[:value]) %></p>
